# Server-side only (set in Netlify → Site configuration → Environment variables).
# Without it, checkout runs in demo mode and no card is charged.
STRIPE_SECRET_KEY=sk_test_xxx

# Public URL of the site, used for Stripe success/cancel redirects.
# Netlify sets URL automatically in production; override here if needed.
SITE_URL=http://localhost:8888

# Set to "true" once Stripe Tax is enabled on your account.
STRIPE_AUTOMATIC_TAX=false

# Build-time: allow the no-payment demo checkout in a production build
# (e.g. for a staging preview). Never enable on the live store.
VITE_DEMO_CHECKOUT=false
